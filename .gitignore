# Git ignores for Ascon RTL Project

# Vivado journal and project-tool logs (auto-generated, not meaningful to track)
*.jou
# Vivado simulator logs (noisy, regenerated on every run)
# Exception: results/**/*.log are committed as evidence [F9 fix]
*.log
!results/**/*.log
!results/formal/**/*.log
*.str
*.bit
*.ltx
*.dcp
*.wdb
*.wcfg
*.pb
dfx_runtime.txt
webtalk*
clockInfo.txt
.Xil/
vivado_*.backup.*

# Simulation dumps
*.vcd
*.fst
*.ghw
*.lxt
*.lxt2

# Compiled simulation
*.vvp
*.out
a.out
obj_dir/
sim_build/
xsim.dir/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor temps
*.swp
*.swo
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Large results (keep summaries only)
results/**/*.dcp
results/**/*.bit
results/**/*.wdb

# Scratch and binaries
scratch/
build/
vivado_proj/
tools/sbox_opt/bin/
*.exe
*.elf
*.bin
